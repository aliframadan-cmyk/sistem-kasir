// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model Product {
  id        Int      @id @default(autoincrement())
  barcode   String?  @unique // Tambahan: Untuk scan barcode
  name      String
  category  String   @default("Umum")
  
  // Stok selalu dalam satuan terkecil (Pcs) agar mudah dihitung
  stockPcs  Int      @default(0) 
  qtyPerDus Int      @default(12) // Konversi: 1 Dus = 12 Pcs
  
  buyPrice  Int      @default(0) // Tambahan: Harga Modal per Pcs (Untuk hitung profit)
  pricePcs  Int      // Harga Jual Eceran
  priceDus  Int      // Harga Jual Grosir
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  items     TransactionItem[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  invoiceNo     String   @unique
  
  total         Int      // Total Belanja
  payAmount     Int      @default(0) // Tambahan: Uang yang dibayar customer
  changeAmount  Int      @default(0) // Tambahan: Kembalian
  paymentMethod String   @default("CASH") // Tambahan: CASH, QRIS, TRANSFER
  
  customerType  String   @default("Umum")
  createdAt     DateTime @default(now())
  
  items         TransactionItem[]
}

model TransactionItem {
  id            Int      @id @default(autoincrement())
  
  transactionId Int
  // Tambahan: onDelete: Cascade (Hapus item jika transaksi dihapus)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade) 
  
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  
  // Snapshot Data (Disimpan agar sejarah tidak berubah meski data master berubah)
  productName   String
  unit          String   // "Pcs" atau "Dus"
  qty           Int
  price         Int      // Harga Jual saat itu
  buyPrice      Int      @default(0) // Tambahan: Harga Modal saat itu (Snapshot)
  subtotal      Int
}