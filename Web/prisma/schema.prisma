generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  stock     Int
  createdAt DateTime @default(now())
  items     SaleItem[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  total     Int
  createdAt DateTime @default(now())
  items     SaleItem[]
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  productId Int
  saleId    Int
  qty       Int
  subtotal  Int

  product Product @relation(fields: [productId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id])
}
